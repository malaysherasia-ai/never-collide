{
  "env": {
    "AGENT_NAME": "claude",
    "AGENT_TOOL": "claude-code"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ncl/dispatch"
          }
        ]
      }
    ]
  }
}
