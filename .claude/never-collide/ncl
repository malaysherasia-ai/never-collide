#!/usr/bin/env python3
"""ncl: coordinate coding agents that share one Git repository.

Every agent calls dibs on the paths it is about to touch. Claims live in an
append-only ledger.jsonl on the orphan branch agents/ledger. Git's
fast-forward push is the lock: when two agents write at once, the second push
is rejected, the ledger is re-read, and the overlap check runs again.
"""

import argparse
import datetime as dt
import json
import os
import re
import stat
import subprocess
import sys
from typing import Any, Dict, List, Optional, Sequence, Tuple


VERSION = "0.4.0"
LEDGER_FILE = "ledger.jsonl"
LEDGER_REF = "refs/remotes/origin/agents/ledger"
LEDGER_BRANCH = "refs/heads/agents/ledger"
ACTIVE_STATUSES = ("claimed", "in_progress", "done", "tested")
DEFAULT_TTL_HOURS = 4.0
RETRY_LIMIT = 4
RECENT_HOURS = 24

CONFIG_FILE = ".agents/never-collide.json"
DEFAULT_CONFIG = {"enforce": "warn", "exempt": [], "cache_seconds": 120}
ENFORCE_MODES = ("warn", "deny", "off")
CACHE_DIR = ".ncl"
BUILTIN_EXEMPT = [CONFIG_FILE, CACHE_DIR + "/**"]
HOOK_AGENTS = ("claude", "codex", "gemini", "copilot", "antigravity")
EDIT_MATCHER = "Edit|Write|MultiEdit|NotebookEdit"
DISPATCH_CMD = '"$CLAUDE_PROJECT_DIR"/.claude/hooks/ncl/dispatch'
PAYLOAD_PATH_KEYS = ("file_path", "notebook_path", "path", "filePath",
                     "AbsolutePath", "TargetFile")


class NclError(Exception):
    """An expected command or coordination failure."""


# --- git plumbing -----------------------------------------------------------

def git(args: Sequence[str], input_text: Optional[str] = None,
        check: bool = True) -> subprocess.CompletedProcess:
    result = subprocess.run(
        ["git"] + list(args),
        input=input_text.encode("utf-8") if input_text is not None else None,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    result.stdout = result.stdout.decode("utf-8", errors="replace")
    result.stderr = result.stderr.decode("utf-8", errors="replace")
    if check and result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise NclError(detail or "git command failed")
    return result


def require_origin() -> None:
    if git(["remote", "get-url", "origin"], check=False).returncode:
        raise NclError("this repository needs a Git remote named origin")


def current_branch() -> str:
    return git(["branch", "--show-current"], check=False).stdout.strip()


# --- identity and time ------------------------------------------------------

def agent_name(required: bool = True) -> str:
    value = os.environ.get("AGENT_NAME", "").strip()
    if not value and required:
        raise NclError("AGENT_NAME is unset; each tool needs its own identity "
                       "(for example AGENT_NAME=claude or AGENT_NAME=antigravity)")
    return value or "unknown"


def tool_name() -> str:
    return os.environ.get("AGENT_TOOL", "").strip() or agent_name()


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def iso(moment: dt.datetime) -> str:
    return moment.astimezone(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def parse_timestamp(value: str) -> dt.datetime:
    parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def local_time(value: str) -> str:
    return parse_timestamp(value).astimezone().strftime("%Y-%m-%d %H:%M")


def local_clock(moment: dt.datetime) -> str:
    return moment.astimezone().strftime("%H:%M")


def local_zone() -> str:
    return dt.datetime.now().astimezone().strftime("UTC%z")


# --- path patterns ----------------------------------------------------------

def normalise(path: str) -> str:
    return path.replace("\\", "/").strip().strip("/")


def glob_prefix(pattern: str) -> str:
    """Literal directory prefix before the first wildcard, or "" for none."""
    positions = [position for position in (pattern.find("*"), pattern.find("?"),
                                           pattern.find("[")) if position >= 0]
    if not positions:
        return pattern.rstrip("/")
    prefix = pattern[:min(positions)]
    if "/" in prefix:
        return prefix[:prefix.rfind("/") + 1].rstrip("/")
    return ""


def patterns_overlap(left: str, right: str) -> bool:
    """Conservative overlap check between two claim patterns.

    Two patterns overlap unless their literal prefixes name disjoint
    directories. Anything wildcarded at the root overlaps everything.
    """
    left, right = normalise(left), normalise(right)
    if left == right:
        return True
    left_prefix, right_prefix = glob_prefix(left), glob_prefix(right)
    if not left_prefix or not right_prefix:
        return True
    return (left_prefix == right_prefix
            or left_prefix.startswith(right_prefix + "/")
            or right_prefix.startswith(left_prefix + "/"))


def paths_overlap(left_paths: Sequence[str], right_paths: Sequence[str]) -> bool:
    return any(patterns_overlap(left, right)
               for left in left_paths for right in right_paths)


# --- ledger model -----------------------------------------------------------

def parse_ledger(lines: Sequence[str]) -> List[Dict[str, Any]]:
    records = []
    for number, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            records.append(json.loads(line))
        except ValueError as error:
            raise NclError("ledger line {} is not valid JSON: {}".format(number, error))
    return records


def is_message(record: Dict[str, Any]) -> bool:
    return record.get("kind") == "message"


def latest_states(records: Sequence[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    """Newest state record per task. Messages never change a task's state."""
    latest: Dict[str, Dict[str, Any]] = {}
    for record in records:
        if not is_message(record):
            latest[record["task"]] = record
    return latest


def expires_at(record: Dict[str, Any]) -> dt.datetime:
    hours = float(record.get("ttl_h", DEFAULT_TTL_HOURS))
    return parse_timestamp(record["ts"]) + dt.timedelta(hours=hours)


def is_active(record: Dict[str, Any], now: Optional[dt.datetime] = None) -> bool:
    if record.get("status") not in ACTIVE_STATUSES:
        return False
    return expires_at(record) > (now or now_utc())


def is_expired(record: Dict[str, Any], now: Optional[dt.datetime] = None) -> bool:
    return record.get("status") in ACTIVE_STATUSES and not is_active(record, now)


def is_recent(record: Dict[str, Any], now: Optional[dt.datetime] = None) -> bool:
    age = (now or now_utc()) - parse_timestamp(record["ts"])
    return age <= dt.timedelta(hours=RECENT_HOURS)


# --- ledger storage ---------------------------------------------------------

def repo_root() -> str:
    result = git(["rev-parse", "--show-toplevel"], check=False)
    root = result.stdout.strip() if result.returncode == 0 else os.getcwd()
    return root.replace("\\", "/")


def cache_files() -> Tuple[str, str]:
    base = os.path.join(repo_root(), CACHE_DIR)
    return os.path.join(base, LEDGER_FILE), os.path.join(base, "fetched_at")


def write_cache(records: Sequence[Dict[str, Any]]) -> None:
    ledger_path, stamp_path = cache_files()
    try:
        os.makedirs(os.path.dirname(ledger_path), exist_ok=True)
        with open(ledger_path, "w", encoding="utf-8", newline="\n") as handle:
            for item in records:
                handle.write(json.dumps(item, sort_keys=True, separators=(",", ":")) + "\n")
        with open(stamp_path, "w", encoding="utf-8") as handle:
            handle.write(iso(now_utc()))
    except OSError:
        pass


def read_cache() -> Tuple[Optional[dt.datetime], List[Dict[str, Any]]]:
    ledger_path, stamp_path = cache_files()
    try:
        with open(stamp_path, encoding="utf-8") as handle:
            fetched = parse_timestamp(handle.read().strip())
        with open(ledger_path, encoding="utf-8") as handle:
            return fetched, parse_ledger(handle.read().splitlines())
    except (OSError, ValueError, NclError):
        return None, []


def fetch_ledger() -> Tuple[Optional[str], List[Dict[str, Any]]]:
    """Fetch origin/agents/ledger. Returns (commit, records); (None, []) if absent."""
    fetched = git(["fetch", "--quiet", "origin", "+refs/heads/agents/ledger:" + LEDGER_REF],
                  check=False)
    ref = git(["rev-parse", "--verify", "--quiet", LEDGER_REF], check=False)
    if ref.returncode:
        if fetched.returncode == 0:
            write_cache([])
        return None, []
    commit = ref.stdout.strip()
    content = git(["show", "{}:{}".format(LEDGER_REF, LEDGER_FILE)])
    records = parse_ledger(content.stdout.splitlines())
    if fetched.returncode == 0:
        write_cache(records)
    return commit, records


def ledger_for_check(max_age_seconds: float) -> Tuple[List[Dict[str, Any]], str]:
    """Records for a hook: the local cache while fresh, else a fetch, else
    the stale cache. Returns (records, note); note is "" when nothing is off."""
    fetched, cached = read_cache()
    if fetched is not None and (now_utc() - fetched).total_seconds() <= max_age_seconds:
        return cached, ""
    if git(["remote", "get-url", "origin"], check=False).returncode:
        return cached, "no origin remote; using the local ledger cache"
    fetch = git(["fetch", "--quiet", "origin", "+refs/heads/agents/ledger:" + LEDGER_REF],
                check=False)
    if fetch.returncode != 0:
        if fetched is None:
            return [], "could not fetch the ledger and there is no local cache"
        return cached, "could not fetch the ledger; using the cache from " + iso(fetched)
    ref = git(["rev-parse", "--verify", "--quiet", LEDGER_REF], check=False)
    if ref.returncode:
        write_cache([])
        return [], ""
    content = git(["show", "{}:{}".format(LEDGER_REF, LEDGER_FILE)])
    records = parse_ledger(content.stdout.splitlines())
    write_cache(records)
    return records, ""


# --- config -----------------------------------------------------------------

def config_path() -> str:
    return os.path.join(repo_root(), *CONFIG_FILE.split("/"))


def load_config() -> Dict[str, Any]:
    config = dict(DEFAULT_CONFIG)
    path = config_path()
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as handle:
            text = handle.read().strip()
        try:
            loaded = json.loads(text) if text else {}
        except ValueError as error:
            raise NclError("{} is not valid JSON: {}".format(CONFIG_FILE, error))
        if isinstance(loaded, dict):
            config.update(loaded)
    if config.get("enforce") not in ENFORCE_MODES:
        raise NclError("{}: enforce must be one of {}".format(
            CONFIG_FILE, ", ".join(ENFORCE_MODES)))
    return config


def save_config(config: Dict[str, Any]) -> None:
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as handle:
        json.dump(config, handle, indent=2, sort_keys=True)
        handle.write("\n")


# --- path coverage ----------------------------------------------------------

def pattern_regex(pattern: str) -> "re.Pattern":
    """A claim pattern as a regex over normalised repo-relative paths.

    `**` spans directories, `*` and `?` stay inside one path segment, and a
    pattern without wildcards covers that path and everything under it.
    """
    pattern = normalise(pattern)
    if not any(char in pattern for char in "*?["):
        return re.compile(r"^" + re.escape(pattern) + r"(/.*)?$")
    out, index = [], 0
    while index < len(pattern):
        char = pattern[index]
        if pattern.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("**", index):
            out.append(".*")
            index += 2
        elif char == "*":
            out.append("[^/]*")
            index += 1
        elif char == "?":
            out.append("[^/]")
            index += 1
        elif char == "[":
            end = pattern.find("]", index + 1)
            if end < 0:
                out.append(re.escape(char))
                index += 1
            else:
                out.append("[" + pattern[index + 1:end].replace("\\", "\\\\") + "]")
                index = end + 1
        else:
            out.append(re.escape(char))
            index += 1
    return re.compile("^" + "".join(out) + "$")


def path_matches(pattern: str, path: str) -> bool:
    return pattern_regex(pattern).match(normalise(path)) is not None


def covered_by(path: str, patterns: Sequence[str]) -> bool:
    return any(path_matches(pattern, path) for pattern in patterns)


def holders_of(path: str, states: Dict[str, Dict[str, Any]],
               now: dt.datetime) -> List[Dict[str, Any]]:
    return [item for item in states.values()
            if is_active(item, now) and covered_by(path, item.get("paths", []))]


def relative_to_root(path: str, root: str) -> Optional[str]:
    """Repo-relative path, or None when the path lies outside the repo."""
    path = path.replace("\\", "/").strip()
    if not path:
        return None
    if os.path.isabs(path) or re.match(r"^[A-Za-z]:/", path):
        fold = str.lower if os.name == "nt" else str
        root_norm = fold(root.replace("\\", "/").rstrip("/")) + "/"
        if not fold(path).startswith(root_norm):
            return None
        return normalise(path[len(root_norm):])
    return normalise(path)


def payload_paths(text: str) -> List[str]:
    """File paths named by an agent's tool-call payload. Claude Code, Codex,
    Gemini CLI, Copilot and Antigravity each hand a hook one JSON object; only
    the field names differ."""
    try:
        data = json.loads(text.lstrip("﻿"))
    except ValueError:
        return []
    if not isinstance(data, dict):
        return []
    tool_input = data.get("tool_input")
    if not isinstance(tool_input, dict):
        tool_input = data.get("toolArgs")
    if not isinstance(tool_input, dict):
        call = data.get("toolCall")
        tool_input = call.get("args") if isinstance(call, dict) else None
    if not isinstance(tool_input, dict):
        return []
    for key in PAYLOAD_PATH_KEYS:
        value = tool_input.get(key)
        if isinstance(value, str) and value:
            return [value]
    return []


def staged_paths() -> List[str]:
    result = git(["diff", "--cached", "--name-only", "--diff-filter=ACMR"], check=False)
    return [normalise(line) for line in result.stdout.splitlines() if line.strip()]


def hook_output(agent: str, decision: str, reason: str) -> str:
    """The decision in the dialect AGENT reads. Hooks speak Claude Code's
    shape; the others are translated here."""
    out: Dict[str, Any] = {}
    if agent == "codex" and decision == "ask":
        out["hookSpecificOutput"] = {"hookEventName": "PreToolUse",
                                    "permissionDecision": "allow",
                                    "additionalContext": reason}
    elif agent in ("claude", "codex"):
        out["hookSpecificOutput"] = {"hookEventName": "PreToolUse",
                                    "permissionDecision": decision,
                                    "permissionDecisionReason": reason}
    elif agent == "copilot":
        out["permissionDecision"] = decision
        out["permissionDecisionReason"] = reason
    elif agent == "gemini":
        if decision == "deny":
            out["decision"] = "deny"
            out["reason"] = reason
        else:
            out["systemMessage"] = reason
    elif agent == "antigravity":
        out["decision"] = decision
        out["allow_tool"] = decision != "deny"
        out["reason"] = reason
        if decision == "deny":
            out["deny_reason"] = reason
    return json.dumps(out)


def conflicts_for(record: Dict[str, Any], states: Dict[str, Dict[str, Any]],
                  now: dt.datetime) -> List[Dict[str, Any]]:
    return [current for current in states.values()
            if current.get("agent") != record["agent"]
            and current.get("task") != record["task"]
            and is_active(current, now)
            and paths_overlap(record.get("paths", []), current.get("paths", []))]


def append_ledger(record: Dict[str, Any], validate_claim: bool = False) -> None:
    """Append one record to the ledger with fetch, check, commit, push, retry."""
    require_origin()
    for attempt in range(1, RETRY_LIMIT + 1):
        parent, records = fetch_ledger()
        if validate_claim:
            conflicts = conflicts_for(record, latest_states(records), now_utc())
            if conflicts:
                details = "; ".join(
                    "{} held by {} on {}".format(item["task"], item["agent"],
                                                 ", ".join(item.get("paths", [])))
                    for item in conflicts)
                raise NclError("claim refused, paths overlap active work: " + details
                               + ". Use ncl handoff to ask for them, then stop.")
        payload = "".join(json.dumps(item, sort_keys=True, separators=(",", ":")) + "\n"
                          for item in records)
        payload += json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
        blob = git(["hash-object", "-w", "--stdin"], input_text=payload).stdout.strip()
        tree = git(["mktree"], input_text="100644 blob {}\t{}\n".format(
            blob, LEDGER_FILE)).stdout.strip()
        commit_args = ["commit-tree", tree]
        if parent:
            commit_args.extend(["-p", parent])
        commit_args.extend(["-m", "ncl: {} {} {}".format(
            record["agent"], record["status"], record["task"])])
        commit = git(commit_args).stdout.strip()
        pushed = git(["push", "--quiet", "origin", commit + ":" + LEDGER_BRANCH],
                     check=False)
        if pushed.returncode == 0:
            git(["update-ref", LEDGER_REF, commit], check=False)
            write_cache(list(records) + [record])
            return
        if attempt == RETRY_LIMIT:
            raise NclError("could not update ledger after {} attempts: {}".format(
                RETRY_LIMIT, pushed.stderr.strip() or "push rejected"))


# --- records ----------------------------------------------------------------

def base_record(task: str, status: str,
                previous: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    previous = previous or {}
    record: Dict[str, Any] = {
        "id": task,
        "task": task,
        "agent": agent_name(),
        "tool": tool_name(),
        "status": status,
        "paths": list(previous.get("paths", [])),
        "ts": iso(now_utc()),
        "ttl_h": float(previous.get("ttl_h", DEFAULT_TTL_HOURS)),
    }
    for key in ("intent", "pr", "preview"):
        if previous.get(key):
            record[key] = previous[key]
    branch = current_branch()
    if branch:
        record["branch"] = branch
    return record


def held_task(task: str, records: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
    record = latest_states(records).get(task)
    if not record or not is_active(record):
        raise NclError("no active claim for task {}; run ncl claim first".format(task))
    if record.get("agent") != agent_name():
        raise NclError("task {} is held by {}, not {}".format(
            task, record.get("agent", "unknown"), agent_name()))
    return record


def load_held(task: str) -> Dict[str, Any]:
    require_origin()
    _, records = fetch_ledger()
    return held_task(task, records)


# --- commands ---------------------------------------------------------------

def cmd_whoami(_: argparse.Namespace) -> int:
    print(agent_name())
    return 0


def cmd_claim(args: argparse.Namespace) -> int:
    record = base_record(args.task, "claimed")
    record["paths"] = [normalise(path) for path in args.paths]
    record["intent"] = args.intent
    record["ttl_h"] = float(args.ttl)
    append_ledger(record, validate_claim=True)
    print("Claimed {} for {} ({:g}h TTL).".format(
        args.task, ", ".join(record["paths"]), args.ttl))
    return 0


def cmd_transition(args: argparse.Namespace) -> int:
    previous = load_held(args.task)
    status = {"start": "in_progress", "note": previous["status"], "done": "done",
              "tested": "tested", "release": "released"}[args.command]
    record = base_record(args.task, status, previous)
    for key in ("message", "pr", "evidence", "preview"):
        if getattr(args, key, None):
            record[key] = getattr(args, key)
    append_ledger(record)
    print("Recorded {} for {}.".format(status, args.task))
    return 0


def cmd_handoff(args: argparse.Namespace) -> int:
    """Hand paths to another agent, or ask the holder for them.

    Holder without --paths: the claim is released and marked handoff.
    Holder with --paths: those exact patterns leave the claim.
    Non-holder: a request message; the holder's state is untouched.
    """
    require_origin()
    _, records = fetch_ledger()
    state = latest_states(records).get(args.task)
    holder = state is not None and is_active(state) and state.get("agent") == agent_name()
    paths = [normalise(path) for path in (args.paths or [])]
    message: Dict[str, Any] = {
        "kind": "message", "id": args.task, "task": args.task,
        "agent": agent_name(), "tool": tool_name(),
        "to": args.recipient, "status": "handoff" if holder else "requested",
        "paths": paths or (state or {}).get("paths", []),
        "message": args.message, "ts": iso(now_utc()),
    }
    if current_branch():
        message["branch"] = current_branch()
    append_ledger(message)
    if holder:
        if paths:
            remaining = [path for path in state["paths"] if path not in paths]
            update = base_record(args.task, state["status"], state)
            update["paths"] = remaining
            update["message"] = "handed off {} to {}".format(", ".join(paths), args.recipient)
            append_ledger(update)
            print("Handed {} to {}; {} still holds {}.".format(
                ", ".join(paths), args.recipient, args.task,
                ", ".join(remaining) or "nothing"))
        else:
            update = base_record(args.task, "handoff", state)
            update["to"] = args.recipient
            append_ledger(update)
            print("Handed {} to {} and released the claim.".format(args.task, args.recipient))
    else:
        print("Requested {} from {}. Stop here until they respond.".format(
            args.task, args.recipient))
    return 0


def format_state(item: Dict[str, Any]) -> str:
    lines = ["{:<12} {:<12} {:<10} {}".format(
        item.get("agent", "?"), item.get("status", "?"), item.get("task", "?"),
        ", ".join(item.get("paths", [])) or "-")]
    detail = []
    if item.get("intent"):
        detail.append(item["intent"])
    if item.get("branch"):
        detail.append("branch " + item["branch"])
    if item.get("pr"):
        detail.append("PR " + str(item["pr"]))
    if item.get("preview"):
        detail.append("preview " + item["preview"])
    detail.append("updated " + local_time(item["ts"]))
    if is_active(item):
        detail.append("expires " + local_clock(expires_at(item)))
    lines.append("             " + " | ".join(detail))
    return "\n".join(lines)


def cmd_status(_: argparse.Namespace) -> int:
    require_origin()
    _, records = fetch_ledger()
    states = latest_states(records)
    now = now_utc()
    active = sorted((item for item in states.values() if is_active(item, now)),
                    key=lambda entry: (entry["agent"], entry["task"]))
    expired = [item for item in states.values()
               if is_expired(item, now) and is_recent(item, now)]
    finished = [item for item in states.values()
                if item.get("status") in ("released", "handoff") and is_recent(item, now)]
    messages = [item for item in records if is_message(item) and is_recent(item, now)]

    print("Active claims ({}):".format(local_zone()) if active
          else "No active claims.")
    for item in active:
        print(format_state(item))
    if expired:
        print("\nExpired in the last {}h (paths are free; ask before reusing):".format(
            RECENT_HOURS))
        for item in expired:
            print(format_state(item))
    if finished:
        print("\nReleased or handed off in the last {}h:".format(RECENT_HOURS))
        for item in finished:
            print(format_state(item))
    if messages:
        print("\nMessages in the last {}h:".format(RECENT_HOURS))
        for item in messages:
            print("{}  {} -> {}  {}  [{}]  {}".format(
                local_time(item["ts"]), item["agent"], item.get("to", "?"),
                item["task"], item.get("status", "?"), item.get("message", "")))
            if item.get("paths"):
                print("             paths: " + ", ".join(item["paths"]))
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    require_origin()
    _, records = fetch_ledger()
    if args.task:
        records = [item for item in records if item.get("task") == args.task]
    if args.agent:
        records = [item for item in records if item.get("agent") == args.agent]
    if args.limit:
        records = records[-args.limit:]
    if not records:
        print("No ledger events.")
        return 0
    for item in records:
        extra = item.get("message") or item.get("evidence") or item.get("intent") or ""
        arrow = " -> " + item["to"] if item.get("to") else ""
        print("{}  {:<12} {:<11} {:<10} {}{}  {}".format(
            local_time(item["ts"]), item.get("agent", "?"), item.get("status", "?"),
            item.get("task", "?"), ", ".join(item.get("paths", [])) or "-", arrow, extra))
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    """Are these paths covered by an active claim held by this agent?

    Plain: prints what is not, exits 2 when anything is not. With --hook the
    configured mode applies: warn asks (git: prints and allows), deny denies
    (git: refuses the commit), off is silent.
    """
    config = load_config()
    root = repo_root()
    hook = args.hook
    mode = config["enforce"] if hook else "deny"

    if args.payload:
        raw = [relative_to_root(path, root) for path in payload_paths(sys.stdin.read())]
        paths = [path for path in raw if path]
    elif args.staged:
        paths = staged_paths()
    else:
        raw = [relative_to_root(path, root) for path in args.paths]
        paths = [path for path in raw if path]
    exempt = BUILTIN_EXEMPT + list(config.get("exempt", []))
    paths = [path for path in paths if not covered_by(path, exempt)]

    problems: List[str] = []
    note = ""
    if hook == "git" and current_branch() in ("main", "master"):
        problems.append("this commit is on {}; never-collide work goes on a task "
                        "branch and arrives by pull request".format(current_branch()))
    if paths:
        agent = agent_name(required=False)
        if agent == "unknown":
            problems.append("AGENT_NAME is unset, so no claim can cover {}; set this "
                            "tool's identity and claim the paths".format(", ".join(paths)))
        else:
            records, note = ledger_for_check(float(config.get("cache_seconds", 120)))
            states = latest_states(records)
            now = now_utc()
            mine = [pattern for item in states.values()
                    if item.get("agent") == agent and is_active(item, now)
                    for pattern in item.get("paths", [])]
            for path in paths:
                if covered_by(path, mine):
                    continue
                others = [item for item in holders_of(path, states, now)
                          if item.get("agent") != agent]
                if others:
                    problems.append("{} is held by {}; ask with ncl handoff, then stop".format(
                        path, ", ".join("{} ({})".format(item["agent"], item["task"])
                                        for item in others)))
                else:
                    problems.append("{} is not claimed by {}; run ncl claim first".format(
                        path, agent))

    if not hook:
        for line in problems:
            print(line)
        if note:
            print("note: " + note)
        return 2 if problems else 0
    if not problems or mode == "off":
        return 0
    reason = "never-collide: " + "; ".join(problems)
    if note:
        reason += " (" + note + ")"
    if hook == "git":
        print(reason, file=sys.stderr)
        if mode == "deny":
            print("never-collide: commit refused (enforce is deny; ncl enforce warn relaxes it)",
                  file=sys.stderr)
            return 1
        return 0
    print(hook_output(hook, "deny" if mode == "deny" else "ask", reason))
    return 0


def cmd_enforce(args: argparse.Namespace) -> int:
    config = load_config()
    if not args.mode:
        print(config["enforce"])
        return 0
    config["enforce"] = args.mode
    save_config(config)
    print("Enforcement is now {} ({}).".format(args.mode, CONFIG_FILE))
