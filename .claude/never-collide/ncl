GIT_STUB_LINE = '"$(git rev-parse --show-toplevel)/.claude/hooks/ncl/pre-commit" "$@" || exit 1'
GIT_STUB = """#!/bin/sh
# never-collide pre-commit stub (managed by install.sh)
r="$(git rev-parse --show-toplevel)/.claude/hooks/ncl/pre-commit"
[ -f "$r" ] || exit 0
""" + GIT_STUB_LINE + "\n"


def install_git_stub(root: str) -> str:
    hooks_dir = git(["-C", root, "rev-parse", "--git-path", "hooks"], check=False)
    if hooks_dir.returncode:
        return "git        not a git repository; the commit check runs from Claude Code only"
    path = hooks_dir.stdout.strip()
    if not os.path.isabs(path) and not re.match(r"^[A-Za-z]:", path):
        path = os.path.join(root, path)
    os.makedirs(path, exist_ok=True)
    stub = os.path.join(path, "pre-commit")
    if not os.path.exists(stub):
        with open(stub, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(GIT_STUB)
        make_executable(stub)
        return "git        pre-commit stub installed"
    with open(stub, encoding="utf-8") as handle:
        text = handle.read()
    if "hooks/ncl/pre-commit" in text:
        return "git        pre-commit already calls never-collide"
    lines = text.splitlines()
    exec_lines = [index for index, line in enumerate(lines) if line.startswith("exec ")]
    if "never-again" in text and exec_lines:
        lines.insert(exec_lines[-1], GIT_STUB_LINE)
        with open(stub, "w", encoding="utf-8", newline="\n") as handle:
            handle.write("\n".join(lines) + "\n")
        return "git        never-collide added to the never-again pre-commit stub"
    return ("git        you already have a pre-commit hook; add this line to it:\n"
            "             " + GIT_STUB_LINE)


def make_executable(path: str) -> None:
    try:
        mode = os.stat(path).st_mode
        os.chmod(path, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    except OSError:
        pass


def register_claude(root: str) -> str:
    path = os.path.join(root, ".claude", "settings.json")
    settings: Dict[str, Any] = {}
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as handle:
            text = handle.read().strip()
        try:
            settings = json.loads(text) if text else {}
        except ValueError as error:
            return ("settings   .claude/settings.json could not be parsed ({}); add the "
                    "hook yourself, see README".format(error))
    changed = []
    env = settings.setdefault("env", {})
    if isinstance(env, dict) and not env.get("AGENT_NAME"):
        env["AGENT_NAME"] = "claude"
        env.setdefault("AGENT_TOOL", "claude-code")
        changed.append("AGENT_NAME=claude")
    groups = settings.setdefault("hooks", {}).setdefault("PreToolUse", [])
    present = any("hooks/ncl/dispatch" in str(hook.get("command", "")).replace("\\", "/")
                  for group in groups for hook in (group or {}).get("hooks", []) or [])
    if not present:
        groups.append({"matcher": EDIT_MATCHER,
                       "hooks": [{"type": "command", "timeout": 60, "command": DISPATCH_CMD}]})
        changed.append("PreToolUse dispatch on " + EDIT_MATCHER)
    if not changed:
        return "settings   .claude/settings.json already registers never-collide"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as handle:
        json.dump(settings, handle, indent=2)
        handle.write("\n")
    return "settings   .claude/settings.json: " + ", ".join(changed)


def cmd_install_hooks(_: argparse.Namespace) -> int:
    """Wire the hooks into this repo. Merged, never replaced; safe to re-run."""
    root = repo_root()
    lines = []
    if not os.path.isfile(config_path()):
        save_config(dict(DEFAULT_CONFIG))
        lines.append("config     {} created (enforce: warn)".format(CONFIG_FILE))
    else:
        lines.append("config     {} kept (enforce: {})".format(CONFIG_FILE, load_config()["enforce"]))
    for relative in (".claude/never-collide/ncl", ".claude/hooks/ncl/dispatch",
                     ".claude/hooks/ncl/pre-commit"):
        full = os.path.join(root, *relative.split("/"))
        if os.path.isfile(full):
            make_executable(full)
    lines.append(register_claude(root))
    lines.append(install_git_stub(root))
    for line in lines:
        print("  " + line)
    return 0


REQUIRED_STATUSES = {"done": ("done", "tested", "released"),
                     "tested": ("tested", "released")}


def branch_tasks(branch: str, records: Sequence[Dict[str, Any]]) -> List[str]:
    """Tasks recorded on BRANCH, or named by one of its path segments."""
    tasks: List[str] = []
    segments = set(branch.split("/"))
    for record in records:
        task = record.get("task")
        if task and task not in tasks and (record.get("branch") == branch or task in segments):
            tasks.append(task)
    return tasks


def cmd_verify_pr(args: argparse.Namespace) -> int:
    """Does the ledger cover a pull request? For CI.

    Every path changed between base and head must be covered by a claim on
    the PR's branch, and each such claim must have reached --require (done,
    or tested). TTL is ignored here: a claim that is done stays done.
    """
    config = load_config()
    diff = git(["diff", "--name-only", "{}...{}".format(args.base, args.head)], check=False)
    if diff.returncode:
        raise NclError("could not diff {}...{}: {}".format(
            args.base, args.head, diff.stderr.strip()))
    exempt = BUILTIN_EXEMPT + list(config.get("exempt", []))
    changed = [normalise(line) for line in diff.stdout.splitlines() if line.strip()]
    changed = [path for path in changed if not covered_by(path, exempt)]

    require_origin()
    commit, records = fetch_ledger()
    if commit is None:
        print("never-collide: origin has no agents/ledger branch yet")
        return 1
    states = latest_states(records)
    tasks = branch_tasks(args.branch, records)
    failures: List[str] = []
    if not tasks:
        failures.append("no claim on branch {} (a claim records the branch it was "
                        "made on, or the task id is a segment of the branch name)".format(
                            args.branch))
    patterns: List[str] = []
    for task in tasks:
        state = states.get(task, {})
        status = state.get("status", "?")
        print("{:<12} {:<12} {:<10} {}".format(
            state.get("agent", "?"), status, task, ", ".join(state.get("paths", [])) or "-"))
        if status not in REQUIRED_STATUSES[args.require]:
            failures.append("{} is {}, needs {} (ncl {})".format(
                task, status, " or ".join(REQUIRED_STATUSES[args.require]), args.require))
        patterns.extend(state.get("paths", []))
    for path in changed:
        if not covered_by(path, patterns):
            holders = holders_of(path, states, now_utc())
            who = ", ".join("{} ({})".format(item["agent"], item["task"]) for item in holders)
            failures.append("{} changed without a claim on this branch{}".format(
                path, " (held by " + who + ")" if who else ""))
    print()
    if failures:
        for line in failures:
            print("FAIL " + line)
        return 1
    print("OK   {} changed path(s) covered by {} claim(s) at {}".format(
        len(changed), len(tasks), args.require))
    return 0


# --- feedback and usage count (opt-in) --------------------------------------

REPO = "malaysherasia-ai/never-collide"
FEEDBACK_URL = "https://www.claude-repo.com/api/never-collide/feedback"
RELEASE_URL = "https://api.github.com/repos/{}/releases/latest".format(REPO)


def user_dir() -> str:
    return os.environ.get("NCL_HOME") or os.path.join(os.path.expanduser("~"), ".never-collide")


def prompt_marker() -> str:
    return os.path.join(user_dir(), "prompted")


def mark_prompted() -> None:
    try:
        os.makedirs(user_dir(), exist_ok=True)
        with open(prompt_marker(), "w", encoding="utf-8") as handle:
            handle.write(iso(now_utc()) + "\n")
    except OSError:
        pass


def ask(prompt: str, default: str = "") -> str:
    try:
        return input(prompt).strip() or default
    except (EOFError, KeyboardInterrupt):
        print()
        return default


def feedback_payload(event: str, name: str = "", email: str = "", tools: str = "",
                     message: str = "") -> Dict[str, Any]:
    import platform
    payload: Dict[str, Any] = {
        "project": "never-collide", "event": event, "version": VERSION,
        "os": platform.system(), "python": platform.python_version(),
        "ts": iso(now_utc()),
    }
    for key, value in (("name", name), ("email", email), ("tools", tools), ("message", message)):
        if value and value.strip():
            payload[key] = value.strip()
    return payload


def send_feedback(payload: Dict[str, Any]) -> str:
    import urllib.error
    import urllib.request
    url = os.environ.get("NCL_FEEDBACK_URL") or FEEDBACK_URL
    request = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json",
                 "User-Agent": "never-collide/" + VERSION})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return "{} {}".format(response.status,
                                  response.read(200).decode("utf-8", "replace").strip())
    except (urllib.error.URLError, OSError) as error:
        raise NclError("could not send feedback: {}".format(error))


def collect_feedback_interactively() -> Dict[str, Any]:
    print("  Everything below is optional. Enter skips a field.")
    name = ask("  Name: ")
    email = ask("  Email, if you want a reply: ")
    tools = ask("  Which tools share your repo (e.g. claude, antigravity): ")
    message = ask("  What works, what does not, what you wish it did: ")
    event = "feedback" if any((name, email, tools, message)) else "count"
    return feedback_payload(event, name, email, tools, message)


def confirm_and_send(payload: Dict[str, Any], assume_yes: bool) -> int:
    url = os.environ.get("NCL_FEEDBACK_URL") or FEEDBACK_URL
    print("  This is exactly what will be sent to {}:".format(url))
    print("  " + json.dumps(payload, sort_keys=True))
    if not assume_yes and ask("  Send it? [y/N] ").lower() not in ("y", "yes"):
        print("  Nothing sent.")
        return 0
    reply = send_feedback(payload)
    print("  Sent ({}). Thank you.".format(reply))
    return 0


def cmd_feedback(args: argparse.Namespace) -> int:
    """Send a usage count or feedback. Never without asking, never twice."""
    if args.install_prompt:
        if (os.environ.get("NCL_NO_PROMPT") or not sys.stdin.isatty()
                or os.path.exists(prompt_marker())):
            return 0
        mark_prompted()
        print()
        print("never-collide is free and sends nothing home on its own. Help us count you?")
        print("  [Enter] skip   [c] count me, anonymously   [f] count me and leave feedback")
        choice = ask("  > ").lower()
        if choice == "c":
            return confirm_and_send(feedback_payload("count"), assume_yes=True)
        if choice == "f":
            return confirm_and_send(collect_feedback_interactively(), assume_yes=False)
        print("  Skipped. Later: ncl feedback")
        return 0

    given = any((args.name, args.email, args.tools, args.message))
    if args.count:
        payload = feedback_payload("count")
    elif given:
        payload = feedback_payload("feedback", args.name or "", args.email or "",
                                   args.tools or "", args.message or "")
    elif sys.stdin.isatty():
        payload = collect_feedback_interactively()
    else:
        raise NclError("nothing to send; pass --message, --count, or run interactively")
    if args.dry_run:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    return confirm_and_send(payload, args.yes)


# --- upgrade ----------------------------------------------------------------

def version_tuple(value: str) -> Tuple[int, ...]:
    return tuple(int(part) for part in re.findall(r"\d+", value)[:3])


def latest_release() -> Tuple[str, str]:
    """(tag, tarball url) of the newest GitHub release."""
    import urllib.request
    url = os.environ.get("NCL_UPDATE_URL") or RELEASE_URL
    request = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json", "User-Agent": "never-collide/" + VERSION})
    with urllib.request.urlopen(request, timeout=20) as response:
        data = json.load(response)
    tag = data["tag_name"]
    return tag, "https://github.com/{}/archive/refs/tags/{}.tar.gz".format(REPO, tag)


def source_version(directory: str) -> Optional[str]:
    path = os.path.join(directory, "VERSION")
    if not os.path.isfile(path) or not os.path.isfile(os.path.join(directory, "install.sh")):
        return None
    with open(path, encoding="utf-8") as handle:
        return handle.read().strip()


def fetch_source(url: str, into: str) -> str:
    import tarfile
    import urllib.request
    archive = os.path.join(into, "source.tar.gz")
    with urllib.request.urlopen(url, timeout=60) as response, open(archive, "wb") as handle:
        handle.write(response.read())
    with tarfile.open(archive) as tar:
        tar.extractall(into)
    for name in os.listdir(into):
        candidate = os.path.join(into, name)
        if os.path.isdir(candidate) and source_version(candidate):
            return candidate
    raise NclError("the release archive holds no install.sh")


def bash_path() -> Optional[str]:
    import shutil
    found = shutil.which("bash")
    if found:
        return found
    for candidate in ("C:/Program Files/Git/bin/bash.exe", "C:/Program Files/Git/usr/bin/bash.exe"):
        if os.path.isfile(candidate):
            return candidate
    return None


def cmd_upgrade(args: argparse.Namespace) -> int:
    """`ncl upgrade [--check] [--yes] [--from DIR]`: fetch the newest release
    and run its install.sh here. The one network call ncl makes on its own."""
    import shutil
    import tempfile
    root = repo_root()
    temp = tempfile.mkdtemp(prefix="never-collide-")
    try:
        source = None
        if args.source:
            source = os.path.abspath(args.source)
            new = source_version(source)
            if not new:
                raise NclError("{} holds no never-collide install.sh and VERSION".format(args.source))
            label = "{} ({})".format(new, args.source)
        else:
            try:
                tag, url = latest_release()
            except Exception as error:  # network, JSON, or GitHub shape
                raise NclError("could not reach GitHub: {}. Upgrade by hand: clone {} "
                               "and run bash install.sh here.".format(error, REPO))
            new = tag.lstrip("v")
            label = "{} (release {})".format(new, tag)
        print("  installed  {}".format(VERSION))
        print("  available  {}".format(label))
        if version_tuple(new) <= version_tuple(VERSION):
            print("  Nothing to do: this repo is up to date.")
            return 0
        if args.check:
            print("  Run ncl upgrade to move this repo to {}.".format(new))
            return 0
        if not args.yes and ask("  Upgrade {} -> {} here? Runs the release's install.sh in {} [y/N] "
                                .format(VERSION, new, root)).lower() not in ("y", "yes"):
            print("  Nothing changed.")
            return 1
        if source is None:
            source = fetch_source(url, temp)
        bash = bash_path()
        if not bash:
            raise NclError("no bash found; run this yourself: bash {} {}".format(
                os.path.join(source, "install.sh"), root))
        env = dict(os.environ)
        env.setdefault("NCL_NO_PROMPT", "1")
        return subprocess.call([bash, os.path.join(source, "install.sh"), root], env=env)
    finally:
        shutil.rmtree(temp, ignore_errors=True)


def cmd_version(_: argparse.Namespace) -> int:
    print("ncl {}".format(VERSION))
    return 0


