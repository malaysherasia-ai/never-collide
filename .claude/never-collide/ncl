def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ncl", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version="ncl {}".format(VERSION))
    commands = parser.add_subparsers(dest="command", metavar="command")
    commands.required = True

    def task_parser(name: str, help_text: str) -> argparse.ArgumentParser:
        sub = commands.add_parser(name, help=help_text, description=help_text)
        sub.add_argument("--task", required=True, help="task or issue id, e.g. WCR-42")
        return sub

    commands.add_parser("whoami", help="print AGENT_NAME or fail if it is unset")
    commands.add_parser("status", help="show who holds what right now")

    log = commands.add_parser("log", help="print ledger events, oldest first")
    log.add_argument("--task", help="only this task")
    log.add_argument("--agent", help="only this agent")
    log.add_argument("-n", "--limit", type=int, help="only the last N events")

    claim = task_parser("claim", "call dibs on paths before touching them")
    claim.add_argument("--paths", nargs="+", required=True, metavar="GLOB",
                       help="paths or globs, e.g. 'src/app/locations/**'")
    claim.add_argument("--intent", required=True, help="one line on what you will do")
    claim.add_argument("--ttl", type=float, default=DEFAULT_TTL_HOURS,
                       help="hours before the claim expires (default %(default)s)")

    task_parser("start", "mark a claim as in progress")
    note = task_parser("note", "log progress or an interface change")
    note.add_argument("message")
    done = task_parser("done", "record that the work is committed and a PR is open")
    done.add_argument("--pr", help="pull request number or URL")
    tested = task_parser("tested", "record test evidence and the preview checked")
    tested.add_argument("--evidence", required=True,
                        help="e.g. 'CI green, preview at 390/768/1440'")
    tested.add_argument("--preview", help="preview deployment URL")
    task_parser("release", "release the claim after merge")
    handoff = task_parser("handoff", "hand paths to another agent, or ask its holder for them")
    handoff.add_argument("--to", dest="recipient", required=True,
                         help="AGENT_NAME of the other agent")
    handoff.add_argument("--paths", nargs="+", metavar="GLOB", help="paths involved")
    handoff.add_argument("-m", "--message", default="",
                         help="what the other agent needs to know")

    check = commands.add_parser(
        "check", help="may this agent edit these paths? exit 2 when not",
        description="Exit 0 when every path is covered by an active claim held by "
                    "this agent, 2 otherwise. --hook applies the configured mode.")
    check.add_argument("paths", nargs="*", metavar="PATH")
    check.add_argument("--staged", action="store_true", help="check the staged files")
    check.add_argument("--payload", action="store_true",
                       help="read an agent's tool-call payload from stdin")
    check.add_argument("--hook", choices=("git",) + HOOK_AGENTS,
                       help="answer as a hook for this runner")

    enforce = commands.add_parser("enforce", help="show or set warn, deny or off")
    enforce.add_argument("mode", nargs="?", choices=ENFORCE_MODES)

    commands.add_parser("install-hooks",
                        help="register the edit hook and the git pre-commit stub")

    verify = commands.add_parser(
        "verify-pr", help="CI: every changed path claimed on this branch and done",
        description="Exit 1 unless every path changed between base and head is covered "
                    "by a claim on the branch and that claim has reached --require.")
    verify.add_argument("--base", required=True, help="base ref, e.g. origin/main")
    verify.add_argument("--head", required=True, help="head ref or sha")
    verify.add_argument("--branch", required=True, help="the PR's head branch name")
    verify.add_argument("--require", choices=tuple(REQUIRED_STATUSES), default="done")

    feedback = commands.add_parser(
        "feedback", help="send a usage count or feedback, only if you say so",
        description="Opt in to being counted, or leave feedback. Shows exactly what "
                    "will be sent and sends nothing without a yes.")
    feedback.add_argument("--count", action="store_true", help="count me, no details")
    feedback.add_argument("--name")
    feedback.add_argument("--email")
    feedback.add_argument("--tools", help="which tools share your repo")
    feedback.add_argument("-m", "--message")
    feedback.add_argument("--dry-run", action="store_true", help="print the payload, send nothing")
    feedback.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
    feedback.add_argument("--install-prompt", action="store_true", help=argparse.SUPPRESS)

    upgrade = commands.add_parser("upgrade", help="fetch the newest release and install it here")
    upgrade.add_argument("--check", action="store_true", help="only look")
    upgrade.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
    upgrade.add_argument("--from", dest="source", metavar="DIR", help="install from a local clone")

    commands.add_parser("version", help="print the installed version")
    return parser


